AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USER=admin
AUTH_BOOTSTRAP_ADMIN_PASS=change-me-now
FABRIC_GLOBAL_RAW=false
# Optional global fabric runtime tuning (applied to all model calls)
# Leave empty to use fabric defaults
# FABRIC_GLOBAL_TEMPERATURE=1
# FABRIC_GLOBAL_TOP_P=0.9
# FABRIC_GLOBAL_PRESENCE_PENALTY=0
# FABRIC_GLOBAL_FREQUENCY_PENALTY=0

# If true, pass --raw to fabric and skip chat options (temperature/top_p/etc.)
# Useful for models that reject custom temperature (for example GPT-5/o1/o3/o4 family)
# FABRIC_GLOBAL_RAW=false
